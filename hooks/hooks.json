{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh $CLAUDE_PLUGIN_ROOT/hooks/run.sh $CLAUDE_PLUGIN_ROOT/hooks/memory/session-start.js",
            "timeout": 10000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh $CLAUDE_PLUGIN_ROOT/hooks/run.sh $CLAUDE_PLUGIN_ROOT/hooks/memory/user-prompt-submit.js",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh $CLAUDE_PLUGIN_ROOT/hooks/run.sh $CLAUDE_PLUGIN_ROOT/hooks/quality/block-no-verify.js",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh $CLAUDE_PLUGIN_ROOT/hooks/run.sh $CLAUDE_PLUGIN_ROOT/hooks/quality/config-protection.js",
            "timeout": 3000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh $CLAUDE_PLUGIN_ROOT/hooks/run.sh $CLAUDE_PLUGIN_ROOT/hooks/quality/post-edit-format.js",
            "timeout": 15000
          },
          {
            "type": "command",
            "command": "sh $CLAUDE_PLUGIN_ROOT/hooks/run.sh $CLAUDE_PLUGIN_ROOT/hooks/quality/check-console-log.js",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh $CLAUDE_PLUGIN_ROOT/hooks/run.sh $CLAUDE_PLUGIN_ROOT/hooks/memory/stop.js",
            "timeout": 15000
          },
          {
            "type": "command",
            "command": "sh $CLAUDE_PLUGIN_ROOT/hooks/run.sh $CLAUDE_PLUGIN_ROOT/hooks/notify/stop.js",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh $CLAUDE_PLUGIN_ROOT/hooks/run.sh $CLAUDE_PLUGIN_ROOT/hooks/memory/session-end.js",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
