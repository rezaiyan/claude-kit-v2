{
  "name": "claude-kit-v2",
  "version": "0.1.0",
  "description": "Cross-session memory for Claude Code — auto-summarises every session into SQLite, injects last N summaries on start. No re-briefing. Includes TUI (claudekit) to manage tools.",
  "author": { "name": "rezaiyan" },
  "homepage": "https://github.com/rezaiyan/claude-kit-v2",
  "repository": "https://github.com/rezaiyan/claude-kit-v2",
  "license": "MIT",
  "keywords": ["memory", "sessions", "context", "sqlite", "productivity"],
  "hooksConfig": "hooks/hooks.json",
  "skills": [
    { "name": "spec",       "path": "lib/spec-workflow/skills/spec" },
    { "name": "implement",  "path": "lib/spec-workflow/skills/implement" },
    { "name": "tdd",        "path": "lib/spec-workflow/skills/tdd" },
    { "name": "verify",     "path": "lib/spec-workflow/skills/verify" }
  ]
}
